{
	"name": "ui5.chrome.ai.demo",
	"version": "1.0.0",
	"description": "UI5 Application: ui5.chrome.ai.demo",
	"author": "Peter Muessig",
	"license": "Apache-2.0",
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "ui5 build --clean-dest",
		"build:opt": "ui5 build self-contained --clean-dest --all",
		"start": "ui5 serve --port 8080 -o index.html",
		"start-cdn": "ui5 serve --port 8080 -o index-cdn.html",
		"start-coverage": "ui5 serve --port 8080 --config ui5-coverage.yaml",
		"start:dist": "npm start -- --config ui5-dist.yaml",
		"start-cdn:dist": "npm run start-cdn -- --config ui5-dist.yaml",
		"ts-typecheck": "tsc --noEmit",
		"lint": "eslint webapp",
		"ui5lint": "ui5lint",
		"test-runner": "ui5-test-runner --url http://localhost:8080/test/testsuite.qunit.html",
		"test-runner-coverage": "ui5-test-runner --url http://localhost:8080/test/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
		"test-ui5": "ui5-test-runner --start start-coverage --url http://localhost:8080/test/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
		"test": "npm run lint && npm run test-ui5",
		"wdi5": "wdio run ./webapp/test/e2e/wdio.conf.ts"
	},
	"devDependencies": {
		"@babel/plugin-transform-react-jsx": "^7.29.7",
		"@openui5/types": "^1.153.0",
		"@types/dom-chromium-ai": "^0.0.10",
		"@ui5/cli": "^4.0.57",
		"@ui5/linter": "^1.23.1",
		"@wdio/cli": "^9.32.0",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"@wdio/spec-reporter": "^9.32.0",
		"babel-plugin-istanbul": "^8.0.0",
		"eslint": "^10.5.0",
		"globals": "^17.7.0",
		"rimraf": "^6.1.3",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"ui5-middleware-livereload": "^3.3.1",
		"ui5-test-runner": "^5.13.1",
		"ui5-tooling-transpile": "^3.11.3",
		"wdio-ui5-service": "^3.0.12"
	},
	"dependencies": {
		"@ui5-community/jsx-runtime": "^0.1.5"
	}
}
